<odoo>
    <record id="hr_timesheet_sheet_form" model="ir.ui.view">
        <field name="model">hr_timesheet.sheet</field>
        <field
            name="inherit_id"
            ref="ps_timesheet_invoicing.hr_timesheet_sheet_form_inherited"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='timesheet_ids']/tree/field[@name='kilometers']"
                position="after"
            >
                <field name="had_lunch_boolean" />
            </xpath>
        </field>
    </record>
</odoo>
