<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="crm_monthly_revenue_split_tree_view" model="ir.ui.view">
        <field name="model">crm.monthly.revenue.split</field>
        <field name="arch" type="xml">
            <tree>
                <field name="lead_id" />
                <field name="month_id" />
                <field name="operating_unit_id" />
                <field name="percentage" />
                <field name="revenue" />
                <field name="expected_revenue" />
            </tree>
        </field>
    </record>
    <record id="crm_monthly_revenue_split_view_pivot" model="ir.ui.view">
        <field name="model">crm.monthly.revenue.split</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="lead_id" type="row" />
                <field name="operating_unit_id" type="col" />
                <field name="revenue" type="measure" />
            </pivot>
        </field>
    </record>
    <record id="crm_monthly_revenue_split_view_graph" model="ir.ui.view">
        <field name="model">crm.monthly.revenue.split</field>
        <field name="arch" type="xml">
            <graph stacked="True">
                <field name="lead_id" type="row" />
                <field name="month_id" type="col" />
                <field name="revenue" type="measure" />
            </graph>
        </field>
    </record>
    <record id="crm_monthly_revenue_split_search_view" model="ir.ui.view">
        <field name="model">crm.monthly.revenue.split</field>
        <field name="arch" type="xml">
            <search>
                <field name="lead_id" />
                <field name="month_id" />
                <field name="department_id" />
                <field name="lead_operating_unit_id" />
                <group expand="1" string="Group By">
                    <filter
                        string="Operating Unit"
                        name='lead_operating_unit_id'
                        context="{'group_by':'lead_operating_unit_id'}"
                    />
                    <filter
                        string="Practice"
                        name='department_id'
                        context="{'group_by':'department_id'}"
                    />
                    <filter
                        string="Customer"
                        name='partner_id'
                        context="{'group_by':'partner_id'}"
                    />
                    <filter
                        string="Project"
                        name='project_id'
                        context="{'group_by':'project_id'}"
                    />
                    <filter
                        string="Opportunity"
                        name='name'
                        context="{'group_by':'name'}"
                    />
                    <filter
                        string="Salesperson"
                        name='user_id'
                        context="{'group_by':'user_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="crm_monthly_revenue_split_report_action" model="ir.actions.act_window">
        <field name="name">Monthly Revenue Split Analysis</field>
        <field name="res_model">crm.monthly.revenue.split</field>
        <field name="view_mode">pivot,graph,tree,form</field>
    </record>
</odoo>
